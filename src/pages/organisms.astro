---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../content/pages/organisms.html?raw';
import { pages } from '../data/site';
const page = pages.organisms;
---
<BaseLayout title={page.title} description={page.description} path={page.path} nav={page.nav}>
  <Fragment set:html={bodyHtml} />
</BaseLayout>
